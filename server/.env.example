# =============================
# Server Environment (Example)
# Copy to: server/.env
# =============================

# Node environment: development | production
NODE_ENV=development

# Server port
PORT=5050

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/car_platform

# JWT secret (use a long random string in real .env)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# JWT expiry (e.g. 7d, 1h, 30m)
JWT_EXPIRES_IN=7d
