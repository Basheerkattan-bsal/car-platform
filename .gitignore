cat > .gitignore << 'EOF'
# deps
node_modules/
**/node_modules/
server/node_modules/

# env
.env
**/.env
# Next env files
**/.env.local
**/.env.*local
.env
.env.*

# uploads
server/uploads/
**/uploads/

# build
.next/
dist/
build/
out/

# logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# editor / OS
.vscode/
.DS_Store
EOF